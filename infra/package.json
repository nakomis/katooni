{
  "name": "katooni-infra",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "scripts": {
    "build": "tsc --noEmit",
    "test": "jest --coverage",
    "synth-sandbox": "NPM_ENVIRONMENT=sandbox cdk synth --profile nakom.is-sandbox --all",
    "diff-sandbox": "NPM_ENVIRONMENT=sandbox cdk diff --profile nakom.is-sandbox --all",
    "deploy-sandbox": "NPM_ENVIRONMENT=sandbox cdk deploy --profile nakom.is-sandbox --all --require-approval never",
    "destroy-sandbox": "NPM_ENVIRONMENT=sandbox cdk destroy --profile nakom.is-sandbox --all",
    "synth-prod": "NPM_ENVIRONMENT=prod cdk synth --profile nakom.is-prod --all",
    "diff-prod": "NPM_ENVIRONMENT=prod cdk diff --profile nakom.is-prod --all",
    "deploy-prod": "NPM_ENVIRONMENT=prod cdk deploy --profile nakom.is-prod --all",
    "ci-synth-sandbox": "NPM_ENVIRONMENT=sandbox CDK_DEFAULT_ACCOUNT=000000000000 cdk synth --all",
    "ci-synth-prod": "NPM_ENVIRONMENT=prod CDK_DEFAULT_ACCOUNT=000000000000 cdk synth --all"
  },
  "dependencies": {
    "aws-cdk-lib": "2.257.0",
    "constructs": "^10.0.0"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "22.x",
    "aws-cdk": "^2.1125.0",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  }
}
