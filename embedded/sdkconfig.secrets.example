# Copy to sdkconfig.secrets (never committed) and fill in. idf.py picks it up after sdkconfig.defaults;
# delete sdkconfig and rebuild after changing it, because an existing sdkconfig wins over defaults.
CONFIG_KATOONI_WIFI_SSID="your-ssid"
CONFIG_KATOONI_WIFI_PASSWORD="your-password"
# Password for the fallback access point Katooni runs when it can't join the network (8+ characters;
# leave empty for an open one).
CONFIG_KATOONI_AP_PASSWORD=""
